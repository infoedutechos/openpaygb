# Copy to `.env` and fill in values. Never commit real secrets.

# --- Core ---
NODE_ENV=development
# Canonical public site URL (OAuth redirects, emails, webhooks). Must match the URL users
# actually open in the browser for those flows; TON Connect manifest uses the request host
# (window.location.origin on the client), not this env value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Prisma; MongoDB connection string) ---
DATABASE_URL=
# Set true to allow tuition restore (replace/merge) in production — use only for controlled DR
# ALLOW_TUITION_RESTORE=false
# Legacy alias some scripts accept
# MONGODB_URI=

# --- Auth (JWT; min 16 characters each — fall back to JWT_SECRET when unset) ---
JWT_SECRET=
# JWT_SECRET_ADMIN=
# JWT_SECRET_STUDENT=
# JWT_SECRET_CHECKOUT=
# JWT_SECRET_RECEIPT=
# Optional distributed rate limits (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Tuition admin (ODELHUB Pay shell) ---
ADMIN_PASSWORD=
# Set true on localhost to allow URA-style admin shell without item passwords (see utils/admin-session.ts)
ACCESS_ADMIN=false
# Per-section admin UI gates
ADMIN_ITEM_PASSWORD=
ADMIN_MANUAL_PAYMENT_CONFIRM=false

# --- Seed (.env.local overrides .env for these) ---
# scripts/seed.ts (full wipe), scripts/ensure-admin-login.ts (admin only), scripts/set-master-login.ts
# SEED_ADMIN_EMAIL=admin@odelhub.local
# SEED_ADMIN_PASSWORD=ChangeMe_Admin123!
# SEED_MASTER_EMAIL=
# SEED_MASTER_PASSWORD=
# SEED_STUDENT_EMAIL=
# SEED_STUDENT_PASSWORD=

# --- Google OAuth (student sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Brevo recommended — free tier; Resend still supported) ---
EMAIL_PROVIDER=auto
BREVO_API_KEY=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=ODEL HUB <noreply@yourdomain.com>
RESEND_FROM=

# --- TON / payments ---
# Optional fixed UGX added to every checkout (transaction / processing charge). Schools can override per tenant in Manager.
# When the platform default (Master → Default transaction / processing charge) is -1, this env value is used for inheriting schools.
CHECKOUT_PLATFORM_FEE_UGX=0
ODELHUB_TON_WALLET_ADDRESS=
# Fallback UGX per 1 TON when live market + DB rates are unavailable
DEFAULT_UGX_PER_TON=257000
# Live TON/UGX: CoinGecko, CryptoCompare, TonAPI, Binance (+ USD→UGX cross). Median when several agree.
FX_LIVE_ENABLED=true
FX_CACHE_TTL_SECONDS=300
# Optional: improves TonAPI rate limits (also used for on-chain confirm)
# TONAPI_KEY=
TON_NETWORK=
TONAPI_KEY=
TONCENTER_API_KEY=
TON_CONFIRM_ENABLED=true
# Required in production for /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Optional: protect GET /api/health in production (Authorization: Bearer <HEALTH_CHECK_SECRET>)
# HEALTH_CHECK_SECRET=
# Pending tuition payments older than this (hours) are auto-marked failed (hourly cron).
PENDING_PAYMENT_TTL_HOURS=48
# Telegram bot tenant (active org slug); defaults to default org.
TELEGRAM_ORG_SLUG=default
NEXT_PUBLIC_TON_PAY_CHAIN=
NEXT_PUBLIC_TON_PAY_API_KEY=
TON_PAY_API_KEY=

# --- LivePay (Uganda UGX MTN/Airtel) — https://docs.livepay.me/overview ---
# Dashboard webhook URL must match LIVEPAY_WEBHOOK_URL or NEXT_PUBLIC_APP_URL + /api/webhooks/livepay
# LIVEPAY_WEBHOOK_URL=https://your-host/api/webhooks/livepay
LIVEPAY_API_KEY=
LIVEPAY_ACCOUNT_NUMBER=
LIVEPAY_WEBHOOK_SECRET=

# --- VixonPay (Uganda UGX MoMo) — https://docs.vixonpay.com/pay ---
# Dashboard webhook URL must match VIXONPAY_WEBHOOK_URL or NEXT_PUBLIC_APP_URL + /api/webhooks/vixonpay
# VIXONPAY_WEBHOOK_URL=https://your-host/api/webhooks/vixonpay
VIXONPAY_API_KEY=
VIXONPAY_WEBHOOK_SECRET=

# --- Relworx (UG/KE/TZ MoMo) — https://payments.relworx.com/docs/ ---
# Webhook URL: NEXT_PUBLIC_APP_URL + /api/webhooks/relworx (or RELWORX_WEBHOOK_URL)
# RELWORX_WEBHOOK_URL=https://your-host/api/webhooks/relworx
RELWORX_API_KEY=
RELWORX_ACCOUNT_NO=
RELWORX_WEBHOOK_KEY=
# RELWORX_CURRENCY=UGX
# RELWORX_ENABLED=false

# --- MoMo ---
MOMO_PROVIDER=
MOMO_SUBSCRIPTION_KEY=
MOMO_COLLECTION_URL=
# Required in production for POST /api/webhooks/momo (header x-momo-webhook-secret)
MOMO_WEBHOOK_SECRET=

# --- OpenPayGB brand — mobile money rails: Mbiyo (MbiyoPay API) + LivePay (Uganda) ---
# Dashboard: https://dashboard.mbiyo.africa/user/profile/index/api
# Webhook URL on Mbiyo: https://<NEXT_PUBLIC_APP_URL host>/api/webhooks/mbiyo
# See docs/MBIYO_WEBHOOK_SETUP.md
#
# API Keys → MBIYO_SECRET_KEY (server only; Live for production, Test for local sandbox)
MBIYO_SECRET_KEY=
MBIYO_API_BASE_URL=https://dashboard.mbiyo.africa/api/v1
# Webhook Secret on Mbiyo dashboard → must match exactly (not the API key)
MBIYO_WEBHOOK_SECRET=
# Public keys → NEXT_PUBLIC_MBIYO_PUBLIC_KEY (Live for production, Test for local)
NEXT_PUBLIC_MBIYO_PUBLIC_KEY=

# --- Telegram (game + announcements) ---
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_ANNOUNCEMENT_CHANNEL_ID=
FORCE_TELEGRAM_AUTH=false
BYPASS_TELEGRAM_AUTH=false

# --- Telegram WebApp / UI (public) ---
NEXT_PUBLIC_BOT_USERNAME=
NEXT_PUBLIC_BYPASS_TELEGRAM_AUTH=false
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_DEV_DISPLAY_NAME=
NEXT_PUBLIC_SKIP_DISTRICT_GATE=false
NEXT_PUBLIC_CHANNEL_LINK=

# --- Support widget (public) ---
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Bridge / integrations ---
BRIDGE_WEBHOOK_URL=
BRIDGE_WEBHOOK_SECRET=
EXCHANGE_SWAP_URL=

# --- Support chat (OpenAI) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Docs / tooling (optional) ---
# GITHUB_TOKEN=   # classic PAT for public repo; raises GitHub API limits when running npm run sync:play-hub / sync:ura-*
# PRISMA_VERBOSE_ERRORS=
# ODOC_TREE_PRUNE_DIRS=
