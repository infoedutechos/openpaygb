{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/confirm-ton",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/expire-pending-payments",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/telegram-tuition-reminders",
      "schedule": "0 9 * * 1"
    }
  ]
}
