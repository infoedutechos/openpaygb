  providerToken    String   @default("")
  last4            String   @default("")
  /** visa | mastercard | unknown */
  network          String   @default("visa")
  /** pending | active | frozen | closed | failed */
  status           String   @default("pending")
  currency         String   @default("UGX")
  clientReference  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerCardId])
  @@index([studentId])
  @@index([organizationId, status])
  @@index([clientReference])
  @@map("network_issued_cards")
}

