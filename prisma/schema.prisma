/**
 * Universal OPGB settlement wallet (Phase 1: 1 OPGB minor unit = 1 UGX).
 * OpenPayGB card balance stays in sync for card holders.
 */
model OpgbWallet {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String              @unique @db.ObjectId
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organizationId String              @db.ObjectId
  balanceMinor   Int                 @default(0)
  entries        OpgbLedgerEntry[]
  assetBalances  OpgbAssetBalance[]
  withdraws      OpgbWithdrawRequest[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@map("opgb_wallets")
}

/** Custodial multi-asset balance (crypto custody; OPGB settlement stays in balanceMinor). */
model OpgbAssetBalance {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  walletId  String     @db.ObjectId
  wallet    OpgbWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /** ton | usdt | btc | eth */
  asset     String
  amount    Float      @default(0)
  updatedAt DateTime   @updatedAt

  @@unique([walletId, asset])
  @@index([asset])
  @@map("opgb_asset_balances")
}

/** OPGB or crypto withdraw request (custodial payout queue). */
model OpgbWithdrawRequest {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  walletId       String     @db.ObjectId
  wallet         OpgbWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  studentId      String     @db.ObjectId
  organizationId String     @db.ObjectId
  /** opgb | ton | usdt | btc | eth | momo */
  asset          String
  amount         Float
  amountUgx      Int
  /** momo | ton | bank */
  rail           String
  destination    String     @default("")
  /** pending | processing | completed | failed */
  status         String     @default("pending")
  referenceKey   String     @unique
  memo           String     @default("")
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("opgb_withdraw_requests")
}

/** Immutable OPGB ledger line (credit/debit in UGX minor units = OPGB). */
model OpgbLedgerEntry {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  walletId          String     @db.ObjectId
