  referenceKey      String     @unique
  sourceRail        String     @default("")
  sourceCurrency    String     @default("UGX")
  sourceAmountMinor Int        @default(0)
  memo              String     @default("")
  balanceAfterMinor Int
  createdAt         DateTime   @default(now())

  @@index([walletId, createdAt])
  @@index([kind])
  @@map("opgb_ledger_entries")
}

