  toCardId     String      @db.ObjectId
  toCard       OpenPayCard @relation("WalletTransferTo", fields: [toCardId], references: [id], onDelete: Cascade)
  amountUgx    Int
  memo         String      @default("")
  status       String      @default("completed")
  createdAt    DateTime    @default(now())

  @@index([fromCardId])
  @@index([toCardId])
  @@map("wallet_transfers")
}

/** Email/phone OTP for guest OpenPayGB card registration (Option B). */
