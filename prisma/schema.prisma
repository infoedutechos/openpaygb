generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PaymentRail {
  telegram
  web
  momo_bridge
  /** Mbiyo rail ? MbiyoPay API (OpenPayGB brand at checkout). */
  mbiyo
  /** LivePay rail ? Uganda UGX MTN/Airtel (OpenPayGB brand at checkout). */
  livepay
  /** Relworx rail ? East Africa MoMo collect (https://payments.relworx.com/docs/). */
  relworx
  /** VixonPay rail ? Uganda UGX MoMo collect (https://docs.vixonpay.com/pay). */
  vixonpay
  /** Closed-loop OpenPayGB platform virtual card balance (UGX ledger). */
  openpay_card
  /** Bank Visa/MC acquiring (Flutterwave / Paystack hosted checkout). */
  card
  /** School admin manual receipt (cash / mobile transfer at desk). */
  manual_cash
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded
}

enum AdminRole {
  master
  org_admin
}

enum OrganizationTenantStatus {
  active
  pending
  rejected
}

/** What kind of institution unit this workspace represents. */
enum OrganizationUnitKind {
  main_campus
  branch
  odel_unit
  study_campus_center
  affiliate
}

/** OdelPay product line: higher education vs primary/secondary schools. */
enum InstitutionTier {
  university
  school
}

/** Nursery / primary / secondary / A-level band for K?12 class rows. */
enum SchoolLevelKind {
  nursery
  primary
  secondary
  a_level
}

/** School chart of accounts ? income (fee heads) vs expenditure. */
enum SchoolAccountKind {
  income
  expenditure
}

enum SchoolStaffStatus {
  active
  inactive
}

enum SchoolStaffSex {
  male
  female
  other
}

/** Every programme belongs to one of two school tracks (admin + checkout grouping). */
enum ProgrammeTrack {
  inservice
  regular
}

/** How a programme fee row is charged at checkout (see `aggregateProgrammeFeesForPeriod` in app code). */
enum ProgrammeFeeRecurrence {
  /** Charged only when the student pays for this exact year and semester. */
  once
  /** Charged whenever the selected year and semester match this row. */
  per_semester
  /** Charged for any semester in the matching year; store `semester` as 0. */
  per_year
}

/** Knowledge articles, notifications, and copilot context by hub. */
enum PlatformAudience {
  all
  tuition
  play
  admin
  dex
}

model Organization {
  id                         String                     @id @default(auto()) @map("_id") @db.ObjectId
  name                       String
  slug                       String                     @unique
  destinationWallet          String                     @default("")
  tenantStatus               OrganizationTenantStatus   @default(active)
  registrationContactEmail String                     @default("")
  registrationNote           String                     @default("")
  /** Optional school website ? used to fetch favicon on workspace activation. */
  registrationWebsiteUrl     String                     @default("")
  /** Set when the applicant confirms their registration email (workspace request). */
  registrationEmailVerifiedAt DateTime?
  /** Higher institutions (university) vs primary/secondary schools ? OdelPay product line. */
  institutionTier            InstitutionTier            @default(university)
  /** What this workspace is (main campus, branch, affiliate, etc.). */
  unitKind                   OrganizationUnitKind       @default(main_campus)
  /** Campus/unit types this institution operates (main campus only; multi-select). */
  operatesUnitKinds          OrganizationUnitKind[]     @default([])
  /** When this workspace is a branch, ODEL unit, study center, or affiliate of another school. */
  parentOrganizationId       String?                    @db.ObjectId
  parentOrganization         Organization?              @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childOrganizations         Organization[]             @relation("OrgHierarchy")
  /** Parent institution name when the parent is not registered on ODEL HUB. */
  externalParentName         String                     @default("")
  /** Raw favicon.ico (or PNG) bytes; paired with faviconUploadedAt when set via Master or school admin. */
  faviconIco                 Bytes?
  faviconUploadedAt          DateTime?
  /** Display label for the active academic year (e.g. 2025/2026) ? school tenants. */
  currentAcademicYearLabel   String                     @default("")
  /** Active school term number (synced from SchoolTerm.termNumber when a term is activated). */
  activeSchoolTerm           Int                        @default(1)
  /** Sequential receipt counter for school manual payments (RP-N). */
  schoolReceiptCounter       Int                        @default(0)
  /**
   * SchoolPay-style numeric School Code (6 digits, unique app-side). Parents/agents use it with a
   * student's admission/registration number to find the school and start fee checkout.
   */
  schoolPayCode              String                     @default("")
  /**
   * When true, school/higher admin has saved their preferred admission/registration number format
   * under Settings. Until then, Create student shows a Configure format CTA (defaults still work).
   */
  admissionFormatConfigured  Boolean                    @default(false)
  /** Custom prefix for admission numbers (e.g. RIV). Empty = derive from slug (first 3 alphanumerics). */
  admissionPrefix            String                     @default("")
  /** Include a year/session token between prefix and sequence. */
  admissionIncludeYear       Boolean                    @default(true)
  /** calendar = YYYY; academic = digits from currentAcademicYearLabel; none = omit year even if includeYear. */
  admissionYearSource        String                     @default("calendar")
  /** Zero-padded sequence width (3?6). */
  admissionSeqDigits         Int                        @default(4)
  /** Separator between parts (typically "-"). */
  admissionSeparator         String                     @default("-")
  /** When no matching numbers exist yet, start sequence from this value (usually 1). */
  admissionSeqStart          Int                        @default(1)
  /**
   * When true, admin has saved preferred Staff ID format under Settings.
   * Until then, New Staff shows a Configure format CTA (defaults still work).
   */
  staffFormatConfigured      Boolean                    @default(false)
  /** Custom prefix for Staff IDs (e.g. STF). Empty = derive from slug. */
  staffPrefix                String                     @default("")
  staffIncludeYear           Boolean                    @default(true)
  staffYearSource            String                     @default("calendar")
  staffSeqDigits             Int                        @default(4)
  staffSeparator             String                     @default("-")
  staffSeqStart              Int                        @default(1)
  /**
   * Configurable staff duty catalogue for HR forms.
   * JSON array: `[{ "label": "DOS", "category": "teaching" | "non_teaching" }, ...]`
   */
  staffDuties                Json                       @default("[]")
  /** School letterhead for receipts ? phone / email / address (public-safe). */
  letterheadPhone            String                     @default("")
  letterheadEmail            String                     @default("")
  letterheadAddress          String                     @default("")
  /** Optional letterhead logo (PNG/ICO); receipts fall back to favicon when unset. */
  letterheadLogo             Bytes?
  letterheadLogoUploadedAt   DateTime?
  /** Active academic session row (optional; falls back to currentAcademicYearLabel). */
  activeSchoolSessionId      String?                    @db.ObjectId
  activeSchoolSession        SchoolSession?             @relation("ActiveSchoolSession", fields: [activeSchoolSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** Active custom school term row (optional; syncs activeSchoolTerm number). */
  activeSchoolTermId         String?                    @db.ObjectId
  activeSchoolTermRow        SchoolTerm?                @relation("ActiveSchoolTerm", fields: [activeSchoolTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /**
   * Fixed UGX added at checkout (processing / platform). **-1** = use deployment env `CHECKOUT_PLATFORM_FEE_UGX`;
   * **? 0** = override for this tenant (UGX, capped server-side).
   */
  /**
   * Processing charge override: **inherit** (use platform default), **fixed_ugx**, or **percent** of subtotal.
   * Legacy: `checkoutPlatformFeeUgx` ? 0 without kind still treated as fixed UGX.
   */
  checkoutPlatformFeeKind    String                     @default("inherit")
  checkoutPlatformFeeUgx     Int                        @default(-1)
  /** When kind is **percent**, e.g. 3 = 3% of tuition subtotal per charge. */
  checkoutPlatformFeePercent Float                      @default(0)
  /**
   * TON/UGX checkout rate override for this tenant. **inherit** = use platform master setting;
   * **none** = live market median; **fixed** / **buffer_pct** = school-specific override (takes precedence over platform).
   */
  fxOverrideKind             String                     @default("inherit")
  fxOverrideUgxPerTon      Float?
  /** When `fxOverrideKind` is `buffer_pct`, added % on live median (e.g. 2.5 = +2.5%). */
  fxOverrideBufferPct      Float                      @default(0)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  programmes                 Programme[]
  students                   Student[]
  payments                   Payment[]
  fxRates                    FxRate[]
  adminUsers                 AdminUser[]
  partnerApiKeys             PartnerApiKey[]
  partnerWebhookEndpoints    PartnerWebhookEndpoint[]
  developerApps              DeveloperApp[]
  mobileMoneyProviders       MobileMoneyProvider[]
  workspaceVerifyToken     OrganizationWorkspaceVerifyToken?
  paymentRequests            PaymentRequest[]
  schoolClasses              SchoolClass[]
  schoolStreams              SchoolStream[]
  schoolSessions             SchoolSession[]            @relation("OrgSchoolSessions")
  schoolTerms                SchoolTerm[]               @relation("OrgSchoolTerms")
  schoolAccounts             SchoolAccount[]
  schoolFundsAppropriations  SchoolFundsAppropriation[]
  schoolStaff                SchoolStaff[]
  schoolOutflowVouchers      SchoolOutflowVoucher[]
  schoolSalaryPayments       SchoolSalaryPayment[]
  schoolInventoryItems       SchoolInventoryItem[]
  schoolSmisEntries          SchoolSmisEntry[]
  schoolCashbookDeposits     SchoolCashbookDeposit[]
  schoolFeeReminderLogs      SchoolFeeReminderLog[]
  studentBillCharges         StudentBillCharge[]
  paymentAllocations         PaymentAllocation[]

  @@index([tenantStatus])
  @@index([institutionTier])
  @@index([tenantStatus, institutionTier])
  @@index([registrationContactEmail])
  @@index([parentOrganizationId])
  @@index([unitKind])
  @@map("organizations")
}

/** One-time email verification after a school workspace self-registration request. */
model OrganizationWorkspaceVerifyToken {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @unique @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@map("organization_workspace_verify_tokens")
}

enum MobileMoneyProviderAuthKind {
  shared_secret_header
  hmac_sha256_body
}

enum MobileMoneyProviderStatus {
  active
  disabled
}

/** Master-configured mobile-money PSP; inbound callbacks at `/api/webhooks/provider/{code}`. */
model MobileMoneyProvider {
  id                  String                      @id @default(auto()) @map("_id") @db.ObjectId
  code                String                      @unique
  name                String
  status              MobileMoneyProviderStatus   @default(disabled)
  paymentRail         PaymentRail                 @default(momo_bridge)
  authKind            MobileMoneyProviderAuthKind @default(shared_secret_header)
  webhookSecret       String                      @default("")
  webhookHeaderName   String                      @default("x-provider-webhook-secret")
  orderIdFields       String[]                    @default(["order_id", "paymentId", "payment_id"])
  statusField         String                      @default("status")
  statusSuccessValues String[]                    @default(["successful", "SUCCESS", "success", "SUCCESSFUL"])
  transactionIdField  String                      @default("transaction_id")
  organizationId      String?                     @db.ObjectId
  organization        Organization?               @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  notes               String                      @default("")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("mobile_money_providers")
}

/** Partner / SIS machine-to-machine API keys (Bearer `odelhub_live_?`). */
model PartnerApiKey {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  keyPrefix      String
  keyHash        String        @unique
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  developerAppId String?       @db.ObjectId
  developerApp   DeveloperApp? @relation(fields: [developerAppId], references: [id], onDelete: SetNull)
  scopes         String[]      @default(["payments:read"])
  enabled        Boolean       @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([developerAppId])
  @@index([keyPrefix])
  @@map("partner_api_keys")
}

/** Outbound partner webhooks (payment.confirmed, etc.). */
model PartnerWebhookEndpoint {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  url            String
  secret         String
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  developerAppId String?       @db.ObjectId
  developerApp   DeveloperApp? @relation(fields: [developerAppId], references: [id], onDelete: SetNull)
  events         String[]      @default(["payment.confirmed"])
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, enabled])
  @@index([developerAppId, enabled])
  @@map("partner_webhook_endpoints")
}

model PartnerWebhookDelivery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  endpointId String   @db.ObjectId
  event      String
  paymentId  String?
  statusCode Int?
  success    Boolean  @default(false)
  error      String   @default("")
  createdAt  DateTime @default(now())

  @@index([endpointId, createdAt])
  @@map("partner_webhook_deliveries")
}

/** Self-serve OAuth app registry for third-party OPGB / Dex integrators. */
model DeveloperApp {
  id               String                   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String                   @unique
  contactEmail     String
  clientId         String                   @unique
  clientSecretHash String
  redirectUris     String[]                 @default([])
  brandingName     String                   @default("")
  brandingLogoUrl  String                   @default("")
  /** Hex primary color for hosted checkout (e.g. #7c3aed). */
  brandingPrimaryColor String               @default("")
  brandingAccentColor  String               @default("")
  /** When true, checkout hides OpenPayGB marketing chrome (keeps small ?Powered by? unless fully muted). */
  whiteLabelMode   Boolean                  @default(false)
  /** Set when white-label was first successfully activated (activation fee paid or waived). */
  whiteLabelActivatedAt DateTime?
  whiteLabelActivationPaidUgx Int           @default(0)
  supportEmail     String                   @default("")
  supportUrl       String                   @default("")
  /**
   * Who pays the OPGB platform fee: pass_through = added on top of order for customer;
   * absorb = deducted from merchant net (customer pays order only).
   */
  platformFeePayer String                   @default("pass_through")
  /** Optional merchant surcharge on top of order (customer-facing). */
  merchantSurchargePercent Float            @default(0)
  merchantSurchargeFixedUgx Int             @default(0)
  /**
   * Override platform fee for this app: inherit | fixed_ugx | percent | none.
   * inherit = SiteUiSettings merchantChargePlatformFee* defaults.
   */
  platformFeeOverrideKind    String         @default("inherit")
  platformFeeOverrideUgx     Int            @default(-1)
  platformFeeOverridePercent Float          @default(0)
  /** Settled UGX available to cash out (credited when charges confirm). */
  settlementBalanceUgx Int                  @default(0)
  payoutPhone          String               @default("")
  /** MTN | AIRTEL | "" */
  payoutNetwork        String               @default("")
  scopes           String[]                 @default(["dex:quote:read", "opgb:balance:read", "payments:read"])
  enabled          Boolean                  @default(true)
  organizationId   String?                  @db.ObjectId
  organization     Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /**
   * Shadow Student id used as OpenPayGB card holder for this integrator app (wallet / MoMo / TON).
   * Not a tuition enrollee ? programmeCode DEVELOPER_CARD.
   */
  openPayStudentId String?                  @db.ObjectId
  apiKeys          PartnerApiKey[]
  webhooks         PartnerWebhookEndpoint[]
  oauthCodes       OAuthAuthorizationCode[]
  dexIntents       DexPaymentIntent[]
  merchantCharges  MerchantCharge[]
  merchantPayouts  MerchantPayout[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([contactEmail])
  @@index([organizationId])
  @@index([openPayStudentId])
  @@map("developer_apps")
}

/** OAuth 2.0 authorization codes (authorization_code grant). */
model OAuthAuthorizationCode {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  developerAppId String       @db.ObjectId
  developerApp   DeveloperApp @relation(fields: [developerAppId], references: [id], onDelete: Cascade)
  code           String       @unique
  redirectUri    String
  scopes         String[]     @default([])
  state          String       @default("")
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([developerAppId, expiresAt])
  @@map("oauth_authorization_codes")
}

/** Partner Dex payment intent (buy / sell / convert) created via write API. */
model DexPaymentIntent {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  developerAppId String       @db.ObjectId
  developerApp   DeveloperApp @relation(fields: [developerAppId], references: [id], onDelete: Cascade)
  apiKeyId       String?      @db.ObjectId
  /** buy | sell | convert */
  type           String
  /** pending | completed | cancelled | expired */
  status         String       @default("pending")
  crypto         String
  fiatAmountUgx  Int?
  cryptoAmount   Float?
  quoteJson      String       @default("{}")
  studentId      String?      @db.ObjectId
  redirectUrl    String       @default("")
  expiresAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([developerAppId, status, createdAt])
  @@index([status, expiresAt])
  @@map("dex_payment_intents")
}

/**
 * Generic merchant charge for third-party apps using OpenPayGB as a payment provider.
 * Hosted checkout: /opgb/checkout/{id}. Not tied to tuition students/programmes.
 */
model MerchantCharge {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  developerAppId String       @db.ObjectId
  developerApp   DeveloperApp @relation(fields: [developerAppId], references: [id], onDelete: Cascade)
  apiKeyId       String?      @db.ObjectId
  organizationId String?      @db.ObjectId
  /** Merchant order / product amount (before fees). */
  orderAmountUgx Int          @default(0)
  /** Total charged to the customer (order + pass-through fees + surcharge). */
  amountUgx      Int
  /** OpenPayGB platform fee retained from this charge. */
  platformFeeUgx Int          @default(0)
  /** Optional merchant surcharge charged to customer. */
  merchantFeeUgx Int          @default(0)
  /** Amount credited to merchant settlement balance on confirm. */
  merchantNetUgx Int          @default(0)
  feeBreakdownJson String     @default("{}")
  currency       String       @default("UGX")
  description    String       @default("")
  metadataJson   String       @default("{}")
  customerEmail  String       @default("")
  customerPhone  String       @default("")
  customerName   String       @default("")
  redirectUrl    String       @default("")
  cancelUrl      String       @default("")
  /** Partner idempotency / order id (unique per developer app when non-empty). */
  externalRef    String       @default("")
  /** pending | collecting | confirmed | failed | expired | cancelled */
  status         String       @default("pending")
  rail           String       @default("")
  momoReference  String       @default("")
  /** True after merchantNetUgx was added to DeveloperApp.settlementBalanceUgx. */
  settledToMerchant Boolean   @default(false)
  paidAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([developerAppId, status, createdAt])
  @@index([developerAppId, externalRef])
  @@index([momoReference])
  @@index([status, expiresAt])
  @@map("merchant_charges")
}

/** Merchant cashout from settlement balance (MoMo payout queue). */
model MerchantPayout {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  developerAppId String       @db.ObjectId
  developerApp   DeveloperApp @relation(fields: [developerAppId], references: [id], onDelete: Cascade)
  amountUgx      Int
  phone          String       @default("")
  /** MTN | AIRTEL */
  network        String       @default("")
  /** pending | processing | paid | rejected | cancelled */
  status         String       @default("pending")
  note           String       @default("")
  rejectionReason String      @default("")
  /** livepay | relworx | sandbox | manual */
  rail           String       @default("manual")
  railReference  String       @default("")
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([developerAppId, status, createdAt])
  @@index([status, createdAt])
  @@map("merchant_payouts")
}

model AdminUser {
  id                    String                    @id @default(auto()) @map("_id") @db.ObjectId
  email                 String                    @unique
  passwordHash          String
  name                  String                    @default("")
  role                  AdminRole                 @default(org_admin)
  organizationId        String?                   @db.ObjectId
  organization          Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  passwordResetTokens   AdminPasswordResetToken[]
  /** Telegram user id for Mini App / bot admin sign-in. */
  telegramId            String                    @default("")
  lastLoginAt           DateTime?
  previousLoginAt       DateTime?
  /** Optional profile photo (PNG, JPEG, WebP, ICO) ? served from /api/auth/admin/profile-image. */
  profileImage          Bytes?
  profileImageUploadedAt DateTime?
  /**
   * Shadow Student id used as OpenPayGB card holder for this admin (wallet / MoMo / TON).
   * Not a tuition enrollee ? programmeCode ADMIN_CARD.
   */
  openPayStudentId      String?                   @db.ObjectId
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([telegramId])
  @@index([openPayStudentId])
  @@map("adminusers")
}

model AdminPasswordResetToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  adminUserId String    @db.ObjectId
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@map("admin_password_reset_tokens")
}

model FxRate {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String       @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ugxPerTon        Float
  source           String       @default("manual")
  effectiveAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@map("fxrates")
}

model SchoolClass {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String          @db.ObjectId
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  levelKind      SchoolLevelKind @default(primary)
  sortOrder      Int             @default(0)
  enabled        Boolean         @default(true)
  /** Academic session this class belongs to (e.g. 2024/2025). */
  schoolSessionId String?        @db.ObjectId
  schoolSession   SchoolSession? @relation(fields: [schoolSessionId], references: [id], onDelete: SetNull)
  streams        SchoolStream[]
  programmes     Programme[]
  students       Student[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, enabled])
  @@index([organizationId, schoolSessionId])
  @@map("school_classes")
}

model SchoolStream {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolClassId  String       @db.ObjectId
  schoolClass    SchoolClass  @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  code           String
  name           String
  sortOrder      Int          @default(0)
  enabled        Boolean      @default(true)
  programmes     Programme[]
  students       Student[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, schoolClassId, code])
  @@index([organizationId])
  @@map("school_streams")
}

model SchoolSession {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation("OrgSchoolSessions", fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activeForOrgs  Organization[] @relation("ActiveSchoolSession")
  billCharges    StudentBillCharge[]
  classes        SchoolClass[]
  students       Student[]
  salaryPayments SchoolSalaryPayment[]

  @@unique([organizationId, label])
  @@index([organizationId, isActive])
  @@map("school_sessions")
}

/** Customisable academic terms (e.g. Term 1, June-August) - same UX pattern as SchoolSession. */
model SchoolTerm {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation("OrgSchoolTerms", fields: [organizationId], references: [id], onDelete: Cascade)
  /** Display label - fully customisable. */
  label          String
  /**
   * Numeric code used by fee ledger / bills (legacy Int term). Unique per org.
   * Defaults to next free integer when created.
   */
  termNumber     Int
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activeForOrgs  Organization[] @relation("ActiveSchoolTerm")

  @@unique([organizationId, label])
  @@unique([organizationId, termNumber])
