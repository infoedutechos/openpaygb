  googleSub            String       @default("")
  /** bcrypt ? set by institution admin (or master); required for `/student` portal sign-in. */
  portalPasswordHash   String?
  programmeCode        String
  /** K?12 class enrollment (school tenants). */
  schoolClassId        String?      @db.ObjectId
  schoolClass          SchoolClass? @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  /** K?12 stream enrollment (school tenants). */
