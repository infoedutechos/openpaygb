/** Platform OpenPayGB virtual card (closed-loop UGX balance; issue fee paid in TON). */
model OpenPayCard {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String    @unique @db.ObjectId
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organizationId   String    @db.ObjectId
  /** pending_issue | active */
  status           String    @default("pending_issue")
  /** When true, card cannot spend / top-up until unblocked. */
  blocked          Boolean   @default(false)
  balanceUgx       Int       @default(0)
  maskedPan        String    @default("")
  issueFeeTon      Float?
  issueMemo        String    @default("")
  issueTxHash      String    @default("")
  issuedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  topups               OpenPayCardTopup[]
  sentTransfers        WalletTransfer[] @relation("WalletTransferFrom")
  receivedTransfers    WalletTransfer[] @relation("WalletTransferTo")

  @@index([organizationId])
  @@index([status])
  @@map("openpay_cards")
}

/**
 * Network Visa/MC card issued via LivePay or Visa Developer (BIN partner).
